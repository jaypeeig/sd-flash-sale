{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/client.ts",
    "src/client.constants.ts",
    "src/env.ts",
    "src/errors.ts",
    "src/errors.types.ts",
    "src/keys.ts"
  ],
  "exclude": ["src/scripts", "src/load-env.ts", "src/**/*.test.ts"]
}
