{
  "name": "@workspace/redis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:pkg-json",
    "build:pkg-json": "node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "redis:up": "docker compose -f ../../docker-compose.yml --project-directory ../.. up -d --wait redis",
    "redis:down": "docker compose -f ../../docker-compose.yml --project-directory ../.. down redis",
    "redis:cli": "docker compose -f ../../docker-compose.yml --project-directory ../.. exec redis redis-cli",
    "redis:flush": "tsx src/scripts/flush.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
}
