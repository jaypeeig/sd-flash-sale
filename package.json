{
  "name": "sd-flash-sale",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "load-test": "npm run -w @workspace/load-test load-test --",
    "setup": "npm run -w @workspace/database db:setup && npm run -w @workspace/redis redis:up && npm run -w @workspace/redis redis:warm"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "turbo": "^2.5.6"
  },
  "packageManager": "npm@11.9.0"
}
