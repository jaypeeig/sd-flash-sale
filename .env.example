POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_DB=flashsale
POSTGRES_PORT=5432

DATABASE_URL=postgresql://flashsale:flashsale@localhost:5432/flashsale

# apps/api's e2e suite (npm run -w api test:e2e) runs only against a database
# whose name ends in "_test" — never point this at a real database. If unset,
# it's derived from DATABASE_URL by appending "_test".
TEST_DATABASE_URL=postgresql://flashsale:flashsale@localhost:5432/flashsale_test

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Same isolation rule as TEST_DATABASE_URL above, via a separate Redis
# logical database (index 1) rather than a separate name.
TEST_REDIS_URL=redis://localhost:6379/1

# API
API_PORT=3000

# apps/web — base URL of the API, including the /api global prefix. Loaded by
# Vite from this root file via envDir in apps/web/vite.config.ts, and INLINED
# INTO THE CLIENT BUNDLE — the VITE_ prefix is what makes Vite expose it.
VITE_API_URL=http://localhost:3000/api
